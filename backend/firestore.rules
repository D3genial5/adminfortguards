rules_version = '2';

// =============================================================================
// FortGuards - Firestore Security Rules
// =============================================================================
// Modelo de auth:
//   - Super Admin  : Firebase Auth + custom claim {role: 'superadmin'}
//   - Admin        : Firebase Auth + custom claim {role: 'admin', condominio}
//   - Guardia      : Firebase Auth + custom claim {role: 'guardia', condominio}
//   - Propietario  : Firebase Auth (Custom Token desde Cloud Function)
//                    + custom claim {role: 'propietario', condominio, casaId}
//   - Visitante    : Firebase Anonymous Auth (sin role). Solo crea/lee sus propios docs.
//
// Los custom tokens los emite la Cloud Function `issueAuthToken` luego de validar
// la password del propietario contra Firestore (server-side).
//
// qrSecret y otros secretos viven en /condominios_secrets/{id}: NEGADOS al cliente,
// accesibles solo vía Admin SDK desde Cloud Functions.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function isAuth()   { return request.auth != null; }
    function uid()      { return isAuth() ? request.auth.uid : ''; }
    function token()    { return isAuth() ? request.auth.token : {}; }
    function role()     { return isAuth() && 'role' in request.auth.token ? request.auth.token.role : ''; }
    function condo()    { return isAuth() && 'condominio' in request.auth.token ? request.auth.token.condominio : ''; }
    function casaIdT()  { return isAuth() && 'casaId' in request.auth.token ? request.auth.token.casaId : ''; }

    function isSuper()       { return role() == 'superadmin'; }
    function isAdmin()       { return role() == 'admin'; }
    function isGuardia()     { return role() == 'guardia'; }
    function isPropietario() { return role() == 'propietario'; }
    function isVisitante()   { return isAuth() && role() == ''; }   // anónimo o sin claim

    function isAdminOf(c)       { return isAdmin()   && (condo() == c || condo() == 'Todos'); }
    function isGuardiaOf(c)     { return isGuardia() && condo() == c; }
    function isPropietarioOf(c, casa) {
      return isPropietario() && condo() == c && casaIdT() == casa;
    }
    function isStaffOf(c)       { return isSuper() || isAdminOf(c) || isGuardiaOf(c); }

    // Helpers de diff (para limitar qué campos se pueden cambiar)
    function changedKeys()    { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(ks)  { return changedKeys().hasOnly(ks); }
    function untouched(ks)    { return !changedKeys().hasAny(ks); }

    function newData() { return request.resource.data; }

    // Condominio de un doc tolerando ambos esquemas de campo
    // (admin escribe `condominioId`, fortguardsapp escribe `condominio`).
    function condoOf(d) { return d.get('condominio', d.get('condominioId', '')); }

    // ==================================================================
    // condominios_secrets — qrSecret, HMAC keys
    // ==================================================================
    // Solo Cloud Functions con Admin SDK. NUNCA cliente.
    match /condominios_secrets/{condoId} {
      allow read, write: if false;
    }

    // ==================================================================
    // condominios
    // ==================================================================
    match /condominios/{condoId} {
      // El doc del condo no tiene secretos (qrSecret vive en
      // condominios_secrets/). Cualquier autenticado puede ver la lista para
      // seleccionar al solicitar acceso.
      allow read   : if isAuth();
      allow create : if isSuper();
      allow update : if isAdminOf(condoId) || isSuper();
      allow delete : if isSuper();

      // -------------------- casas ------------------------------------
      match /casas/{casaId} {
        // Read: staff del condo, propietario del mismo condo (cualquier casa,
        // necesario para listar el dropdown en solicitud de ingreso / seleccion
        // de casa), o visitante autenticado (anon).
        //
        // ⚠️ TRADE-OFF: el doc incluye `passwordHash`. Está protegido por
        // PBKDF2-SHA512 210k iter, pero idealmente debería leerse vía Cloud
        // Function `listCasas(condo)` que devuelva sólo {numero, propietario}.
        allow read   : if isStaffOf(condoId)
                        || (isPropietario() && condo() == condoId)
                        || isVisitante();
        allow create : if isAdmin() || isSuper();
        allow delete : if isAdmin() || isSuper();

        // Update: admin todo. Propietario puede tocar SU código de casa, los
        // contadores asociados y el fcmToken. Campos sensibles (passwordHash,
        // passwordSalt, propietario, residentes, numero) permanecen protegidos.
        allow update : if isAdmin() || isSuper()
                        || (isPropietarioOf(condoId, casaId)
                            && untouched([
                                  'passwordHash', 'passwordSalt', 'password',
                                  'propietario', 'residentes', 'numero'
                                ]));

        match /pagos/{pagoId} {
          // Propietario de ESTA casa registra/lee sus pagos; staff gestiona.
          allow read   : if isStaffOf(condoId) || isPropietarioOf(condoId, casaId);
          allow create : if isStaffOf(condoId) || isPropietarioOf(condoId, casaId);
          allow update, delete : if isSuper() || isAdminOf(condoId);
        }
      }

      // -------------------- notificaciones (subcolección) -------------
      // Solo la lee notificaciones_condominio_screen (hoy nadie escribe ahí).
      match /notificaciones/{notifId} {
        allow read  : if isStaffOf(condoId)
                       || (isPropietario() && condo() == condoId);
        allow write : if isSuper() || isAdminOf(condoId);
      }

      // -------------------- areas_comunes ----------------------------
      match /areas_comunes/{areaId} {
        allow read  : if isStaffOf(condoId)
                       || (isPropietario() && condo() == condoId);
        allow write : if isAdminOf(condoId) || isSuper();
      }

      // -------------------- reservas (subcolección) -------------------
      // El cliente usa condominios/{c}/reservas/{r} además de la
      // colección top-level /reservas. Aquí cubrimos la subcolección.
      match /reservas/{reservaId} {
        allow read   : if isStaffOf(condoId)
                        || (isPropietario() && condo() == condoId);
        // Propietario reserva para SU casa (la app escribe casaNumero).
        allow create : if isStaffOf(condoId)
                        || isPropietarioOf(condoId, string(newData().casaNumero));
        // Propietario cancela/edita su reserva; admin aprueba/rechaza.
        allow update : if isSuper() || isAdminOf(condoId)
                        || isPropietarioOf(condoId, string(resource.data.casaNumero));
        allow delete : if isSuper() || isAdminOf(condoId)
                        || isPropietarioOf(condoId, string(resource.data.casaNumero));
      }
    }

    // ==================================================================
    // administradores
    // ==================================================================
    match /administradores/{adminId} {
      allow read   : if uid() == adminId || isSuper();
      allow create : if isSuper();
      allow delete : if isSuper();
      // El propio admin actualiza su perfil (sin tocar password/role/condominio)
      allow update : if (uid() == adminId
                          && untouched(['passwordHash','password','condominio','role']))
                      || isSuper();
    }

    // ==================================================================
    // guardias_auth
    // ==================================================================
    match /guardias_auth/{guardiaId} {
      // Read abierto a autenticados: la app de guardia consulta por email tras
      // loguear para confirmar el rol. Solo contiene email/condominio (sin
      // secretos). La escritura solo ocurre server-side (Admin SDK / CF).
      allow read  : if isAuth();
      allow write : if isSuper();
    }

    // ==================================================================
    // guardias (datos operativos)
    // ==================================================================
    match /guardias/{guardiaId} {
      // Branch explícito por campo: necesario para que las queries con
      // where('condominioId'==X) sean probables por el motor de reglas.
      allow read   : if isSuper()
                      || ('condominioId' in resource.data
                          && isStaffOf(resource.data.condominioId));
      allow create : if isSuper() || isAdminOf(condoOf(newData()));
      allow update : if isSuper()
                      || isAdminOf(condoOf(resource.data))
                      // El propio guardia actualiza datos operativos (no condominio/rol)
                      || (isGuardiaOf(condoOf(resource.data))
                          && untouched(['condominioId', 'condominio', 'email']));
      allow delete : if isSuper() || isAdminOf(condoOf(resource.data));
    }

    // ==================================================================
    // access_requests — solicitudes de acceso
    // ==================================================================
    match /access_requests/{requestId} {
      // Visitante (o cualquier autenticado) crea su solicitud
      allow create : if isAuth()
                      && newData().creatorUid == uid()
                      && newData().condominio is string
                      && newData().casaNumero != null;

      // Read: cualquier autenticado puede consultar (el dato — nombre, CI,
      // casa solicitada — no es secreto). El control real está en update:
      // sólo el propietario o staff pueden aprobar/decidir el estado.
      allow read   : if isAuth();

      // Update: propietario aprueba/rechaza, guardia marca entrada, visitante cancela
      allow update : if isAuth() && (
                          // Propietario de la casa: aprueba/rechaza + setea QR
                          (isPropietario() && condo() == resource.data.condominio
                              && casaIdT() == string(resource.data.casaNumero)
                              && onlyChanges(['estado','fechaAprobacion','codigoQr',
                                              'tipoAcceso','usosRestantes','codigoUsos',
                                              'fechaExpiracion','duracionValor','duracionUnidad',
                                              'qrPayload','qrSignature']))
                          // Guardia: marca entrada verificada y decrementa usos
                          || (isGuardiaOf(resource.data.condominio)
                              && onlyChanges(['entradaVerificada','fechaEntrada',
                                              'usosRestantes','salidaVerificada','fechaSalida']))
                          // Admin: total dentro de su condominio
                          || isAdminOf(resource.data.condominio)
                          // Visitante creador: solo cancelar
                          || (resource.data.creatorUid == uid()
                              && onlyChanges(['cancelado','fechaCancelacion']))
                        );

      allow delete : if isAdminOf(resource.data.condominio) || isSuper();
    }

    // ==================================================================
    // logs_accesos / access_logs (alias)
    // ==================================================================
    match /logs_accesos/{logId} {
      allow read   : if isStaffOf(resource.data.condominio);
      allow create : if isAuth() && isStaffOf(newData().condominio);
      allow update, delete : if false; // inmutables
    }

    match /access_logs/{logId} {
      allow read   : if isStaffOf(resource.data.condominio);
      allow create : if isAuth() && isStaffOf(newData().condominio);
      allow update, delete : if false;
    }

    // ==================================================================
    // registros_ingreso
    // ==================================================================
    match /registros_ingreso/{regId} {
      // Visitante (anon) escucha la confirmación de su entrada por sessionId:
      // solo puede leer docs de sesión QR, no el historial general.
      allow read   : if isSuper()
                      || ('condominio' in resource.data
                          && isStaffOf(resource.data.condominio))
                      || (isVisitante() && 'sessionId' in resource.data);
      allow create : if isStaffOf(condoOf(newData()));
      allow update : if isStaffOf(condoOf(resource.data));
      allow delete : if isSuper() || isAdminOf(condoOf(resource.data));
    }

    // ==================================================================
    // visitantes
    // ==================================================================
    match /visitantes/{visitanteId} {
      // Visitor crea su propio doc (anónimo o propietario invitando).
      // El docId suele ser el CI; lo importante es marcar creatorUid.
      allow create : if isAuth() && newData().creatorUid == uid();

      // Read: el propio visitante (por uid) o cualquier staff de un condo
      // (los visitantes son referenciados por el guard al escanear QR de otro
      // condo, por eso no se exige condominio específico en el doc visitante).
      allow read   : if isAuth() && (
                          (resource.data.creatorUid == uid())
                          || role() in ['superadmin','admin','guardia']
                        );

      // Update: el propio visitante (ej. reemplazo de fotos / cambio de placa)
      // o staff cualquiera (ej. admin actualizando estado).
      allow update : if isAuth() && (
                          (resource.data.creatorUid == uid()
                            && untouched(['creatorUid']))
                          || role() in ['superadmin','admin']
                        );

      allow delete : if isSuper();
    }

    // ==================================================================
    // notificaciones
    // ==================================================================
    // Dos esquemas conviven: admin usa {condominioId, fechaCreacion, estado};
    // fortguardsapp usa {condominio, casaNumero, fecha, visto} y copias
    // personales con {to: uid|'todos', leida}.
    match /notificaciones/{notifId} {
      allow read   : if isSuper()
                      // Esquema admin: condominioId
                      || ('condominioId' in resource.data
                          && isStaffOf(resource.data.condominioId))
                      // Esquema app propietario: condominio (la app filtra por casa)
                      || ('condominio' in resource.data
                          && (isStaffOf(resource.data.condominio)
                              || (isPropietario()
                                  && resource.data.condominio == condo())))
                      // Copia personal o broadcast
                      || ('to' in resource.data
                          && (resource.data.to == uid()
                              || resource.data.to == 'todos'));
      allow create : if isSuper() || isAdmin() || isGuardia()
                      // Cualquier usuario guarda su propia copia (FCM → Firestore)
                      || newData().get('to', '') == uid();
      allow update : if isSuper()
                      || isAdminOf(condoOf(resource.data))
                      // Marcar como vista/leída
                      || ((resource.data.get('to', '') == uid()
                            || (isPropietario() && condoOf(resource.data) == condo()))
                          && onlyChanges(['visto', 'leida']));
      allow delete : if isSuper() || isAdminOf(condoOf(resource.data));
    }

    // ==================================================================
    // avisos_condominio (sin uso en apps actuales — solo staff)
    // ==================================================================
    match /avisos_condominio/{avisoId} {
      allow read  : if isStaffOf(condoOf(resource.data))
                     || (isPropietario() && condoOf(resource.data) == condo());
      allow write : if isSuper() || isAdminOf(condoOf(newData()));
    }

    // ==================================================================
    // expensas (colección compartida, escribe el admin)
    // ==================================================================
    match /expensas/{expensaId} {
      allow read   : if isSuper()
                      || ('condominioId' in resource.data
                          && (isStaffOf(resource.data.condominioId)
                              || (isPropietario()
                                  && resource.data.condominioId == condo())));
      allow create, update : if isSuper() || isAdminOf(condoOf(newData()));
      allow delete : if isSuper() || isAdminOf(condoOf(resource.data));
    }

    // ==================================================================
    // configuraciones (preferencias por usuario)
    // ==================================================================
    match /configuraciones/{userId} {
      allow read, write : if uid() == userId;
    }

    // ==================================================================
    // reservas (top-level — las apps usan la subcolección; solo staff)
    // ==================================================================
    match /reservas/{reservaId} {
      allow read, write : if isSuper() || isAdminOf(condoOf(resource.data));
    }

    // ==================================================================
    // sesiones / sesiones_activas — vinculadas a auth.uid
    // ==================================================================
    match /sesiones/{sessionId} {
      allow read   : if isAuth() && resource.data.uid == uid();
      allow create : if isAuth() && newData().uid == uid();
      allow update : if isAuth() && resource.data.uid == uid()
                      && newData().uid == uid();
      allow delete : if isAuth() && resource.data.uid == uid();
    }
    match /sesiones_activas/{sessionId} {
      allow read   : if isAuth() && resource.data.uid == uid();
      allow create : if isAuth() && newData().uid == uid();
      allow update : if isAuth() && resource.data.uid == uid()
                      && newData().uid == uid();
      allow delete : if isAuth() && resource.data.uid == uid();
    }

    // ==================================================================
    // qr_invitados
    // ==================================================================
    match /qr_invitados/{qrId} {
      allow read   : if isSuper()
                      || ('condominio' in resource.data
                          && (isStaffOf(resource.data.condominio)
                              || isPropietarioOf(resource.data.condominio,
                                                 resource.data.casaNumero)));
      // Propietario genera QRs solo para SU casa
      allow create : if isSuper() || isAdminOf(newData().condominio)
                      || isPropietarioOf(newData().condominio,
                                         newData().casaNumero);
      // Guardia decrementa usos / cambia estado; propietario revoca el suyo
      allow update : if isSuper()
                      || isStaffOf(resource.data.condominio)
                      || isPropietarioOf(resource.data.condominio,
                                         resource.data.casaNumero);
      allow delete : if isSuper() || isAdminOf(resource.data.condominio)
                      || isPropietarioOf(resource.data.condominio,
                                         resource.data.casaNumero);
    }

    // ==================================================================
    // turnos
    // ==================================================================
    match /turnos/{turnoId} {
      allow read   : if isSuper()
                      || ('condominioId' in resource.data
                          && isStaffOf(resource.data.condominioId));
      allow create : if isSuper() || isAdminOf(condoOf(newData()));
      // Guardia reporta en su turno; admin gestiona
      allow update : if isSuper() || isStaffOf(condoOf(resource.data));
      allow delete : if isSuper() || isAdminOf(condoOf(resource.data));
    }

    // ==================================================================
    // emergencias (sin uso en apps actuales — solo staff)
    // ==================================================================
    match /emergencias/{emerId} {
      allow read, write : if isSuper() || isStaffOf(condoOf(resource.data));
    }

    // ==================================================================
    // alertas (pánico) — propietario crea, staff atiende
    // ==================================================================
    match /alertas/{alertaId} {
      allow read   : if isSuper()
                      || ('condominio' in resource.data
                          && (isStaffOf(resource.data.condominio)
                              || (isPropietario()
                                  && resource.data.condominio == condo())));
      allow create : if isPropietario() && newData().condominio == condo();
      // Guardia/admin atiende (estado, atendidaPor, notas)
      allow update : if isSuper() || isStaffOf(resource.data.condominio);
      allow delete : if isSuper() || isAdminOf(resource.data.condominio);
    }

    // ==================================================================
    // config (flags globales — config/migracion etc.)
    // ==================================================================
    match /config/{configId} {
      allow read  : if isAuth();
      allow write : if isSuper();
    }

    // Default deny — Firestore deniega por defecto, esto es solo recordatorio.
  }
}
