{
  "name": "functions",
  "version": "1.0.0",
  "description": "Cloud Functions para FortGuards",
  "scripts": {
    "build": "tsc",
    "test": "ts-node --transpile-only src/__tests__/crypto.test.ts",
    "serve": "npm run build && firebase emulators:start",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed-emulator": "ts-node --transpile-only scripts/seed_emulator.ts"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "private": true
}
